<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Data: </h1>

   <% if(numberOfUsers === 0){
        %>
            <p> No Users recorded </p>
        <% 
        } else {
            %>
                <p>We found

                    <% if(numberOfUsers === 1){
                        %>
                            <%= numberOfUsers %> user.
                        <%
                    } else { 
                        %>
                            <%= numberOfUsers %> users.
                        <%
                    } %>
                </p>
            <%
        }%>

    <form method = "GET" action = "/usersOrder" >
        <input type = "hidden" name = "order" value = "<%= nextOrder %>">
        <input type = "submit" value = "Order <%= nextOrder %>">
    </form>
    
    <% for (const i of result) { %>
        <ul>
            <li>
                <article>
                   <h2> Name: <%= i.name %> </h2>
                    
                   <a href = "/displayData/<%= i.id %>"> 
                        View information 
                    </a>
                    <br>
                    <a href = "/displayData/<%= i.id %>/edit">
                        Edit data
                    </a>
                    <br>
                    <a href = "/displayData/<%= i.id %>/delete">
                        Delete user information
                    </a>
                </article>
            </li>
        </ul>
    <%
    }
    %>

    <a href = "/back">
        <button>Back to form</button>
    </a>

</body>
</html>