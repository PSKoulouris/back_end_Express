<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Data: </h1>

   <% if(numberOfUsers === 0){
        %>
            <p> No Users recorded </p>
        <% 
        } else {
            %>
                <p>We found

                    <% if(numberOfUsers === 1){
                        %>
                            <%= numberOfUsers %> user.
                        <%
                    } else { 
                        %>
                            <%= numberOfUsers %> users.
                        <%
                    } %>
                </p>
            <%
        }%>
    
    <% for (const i of result) { %>
        <ul>
            <li>
                Name: <%= i.name %>
                Email: <%= i.email%>
                ID: <%= i.id%>
            </li>
        </ul>
    <%
    }
    %>
    <a href = "/back">
        <button>Back to form</button>
    </a>

</body>
</html>