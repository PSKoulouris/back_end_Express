<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>

    <form action = "/displayData/<%= specificUserData.id %>/edit"  method = "POST" enctype ="multipart/form-data">
        <label for = "name">Name: </label>
        <input type = "text" id ="name" name = "name" value= "<%= specificUserData.name%>" >
        <label for = "email">Email: </label>
        <input type = "email" id = "email" name = "email" value = "<%= specificUserData.email %>" >
        <input type = "file" id = "image" name = "image" accept="image/*">
        <br><br>
        <input type = "submit" value = "Save">
    </form>

    <a href="/cancel_edit">
        Cancel
    </a>
    
</body>
</html>